library(readxl); library(tseries); library(forecast)
library(urca); library(vars); library(rugarch)

# ===== ARIMA (pick the ARIMA file) =====
d <- read_excel(file.choose())
y <- na.omit(d[[2]])                # column 2 = the series
r <- diff(log(y))
plot(y, type="l"); plot(r, type="l")
adf.test(y); adf.test(r); pp.test(r); kpss.test(r)
acf(diff(y)); pacf(diff(y))
m <- auto.arima(y); summary(m)
checkresiduals(m)
plot(forecast(m, h=20))

# ===== VAR (pick the VAR file) =====
d <- read_excel(file.choose())
X <- as.data.frame(na.omit(d[, 2:3]))   # 2:4 if three series
R <- diff(log(as.matrix(X)))
j <- ca.jo(log(X), K=2, ecdet="const"); summary(j)
# cajorls(j, r=1)                       # only if cointegrated
p <- VARselect(R, lag.max=10)$selection[[1]]
V <- VAR(R, p=p); summary(V)
roots(V); serial.test(V); arch.test(V); normality.test(V)
a <- colnames(R)[1]; b <- colnames(R)[2]
causality(V, cause=a)$Granger
causality(V, cause=b)$Granger
plot(irf(V, impulse=a, response=b, boot=FALSE))
plot(fevd(V))
fanchart(predict(V, n.ahead=10))

# ===== GARCH (pick the GARCH file) =====
d <- read_excel(file.choose())
r <- diff(log(na.omit(d[[2]])))
Box.test(r^2, 10, "Ljung-Box")
jarque.bera.test(r)
f <- function(type) ugarchfit(ugarchspec(
  variance.model=list(model=type),
  mean.model=list(armaOrder=c(0,0)),
  distribution.model="std"), r)
g <- f("sGARCH"); g
f("eGARCH"); f("gjrGARCH")
z <- as.numeric(residuals(g, standardize=TRUE))
Box.test(z, 10, "Ljung-Box"); Box.test(z^2, 10, "Ljung-Box")
plot(ugarchforecast(g, n.ahead=10), which=3)
