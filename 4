for (i in 1:k) {
  plot(Y[, i], type = "l", col = "#0746ab", main = NAMES[i])
}
par(mfrow = c(1, 1))

# ---- Stationarity (log levels) ----
adf.test(Y$USA)
adf.test(Y$UK)
adf.test(Y$Japan)
adf.test(Y$Brazil)
adf.test(Y$China)
adf.test(Y$India)
adf.test(Y$South.Africa)
kpss.test(Y$USA)

# ---- Returns (Y is already log, so just difference) ----
retusa    <- diff(Y$USA)
retuk     <- diff(Y$UK)
retjapan  <- diff(Y$Japan)
retbrazil <- diff(Y$Brazil)
retchina  <- diff(Y$China)
retindia  <- diff(Y$India)
retsa     <- diff(Y$South.Africa)

adf.test(retusa)
adf.test(retuk)
adf.test(retjapan)
adf.test(retbrazil)
adf.test(retchina)
adf.test(retindia)
adf.test(retsa)

YY <- cbind.zoo(retusa, retuk, retjapan, retbrazil, retchina, retindia, retsa)
plot(YY)

# ---- Optimal lag ----
lagselect <- VARselect(YY, lag.max = 10, type = "const")
lagselect
lagselect$selection

# ---- Johansen cointegration test and VECM ----
Jotest <- ca.jo(Y, type = "trace", ecdet = "trend", K = 2)
summary(Jotest)

model1 <- VECM(Y, lag = 2, r = 1, estim = "ML")
summary(model1)

# ---- VAR model ----
VAR1 <- VAR(YY, lag.max = 1, type = "const")
summary(VAR1)
stargazer(VAR1[["varresult"]], type = "text")

VAR2 <- VAR(YY, type = "const", lag.max = 2, ic = "AIC")
VAR2

# ---- Diagnostics ----
roots(VAR1, modulus = TRUE)                                   # all values < 1
Serial1 <- serial.test(VAR1, lags.pt = 10, type = "PT.asymptotic")
Serial1                                                       # H0: no serial correlation
ARCH1 <- arch.test(VAR1, lags.multi = 10, multivariate.only = TRUE)
ARCH1                                                         # H0: no ARCH effect
NORM1 <- normality.test(VAR1, multivariate.only = TRUE)
NORM1                                                         # H0: residuals normal
Stability1 <- stability(VAR1, type = "OLS-CUSUM")
plot(Stability1)

# ---- Granger causality ----
causality(VAR1, cause = "retusa")
causality(VAR1, cause = "retuk")
causality(VAR1, cause = "retjapan")
causality(VAR1, cause = "retbrazil")
causality(VAR1, cause = "retchina")
causality(VAR1, cause = "retindia")
causality(VAR1, cause = "retsa")

# ---- Impulse response ----
IRF1 <- irf(VAR1, impulse = "retusa", response = "retindia", n.ahead = 10, boot = TRUE)
plot(IRF1, ylab = "retindia", main = "Shock from retusa")

IRF2 <- irf(VAR1, impulse = "retindia", response = "retusa", n.ahead = 10, boot = TRUE)
plot(IRF2, ylab = "retusa", main = "Shock from retindia")

# ---- Variance decomposition ----
FEVDI <- fevd(VAR1, n.ahead = 10)
plot(FEVDI)
FEVDI[["retusa"]]
FEVDI[["retindia"]]

# ---- VAR forecast ----
var_fc <- predict(VAR1, n.ahead = 10, ci = 0.95)
fanchart(var_fc, names = "retusa")
fanchart(var_fc, names = "retindia")

######################################################################
# Dataset 5: GARCH data (Nifty, Gold, Crude)
######################################################################
# ---- Import ----
GARCH <- read_excel("GARCH.xlsx", sheet = "Sheet1")     # change to your file location
Y <- zoo(as.matrix(GARCH[, -1]), order.by = as.Date(GARCH[[1]]))
plot(Y)

rnifty <- diff(log(Y$Nifty))
rgold  <- diff(log(Y$Gold))
rcrude <- diff(log(Y$Crude))
YY <- cbind.zoo(rnifty, rgold, rcrude)

# ---- Step 1: Volatility clustering ----
plot(YY)

# ---- Step 2: ARCH effect (H0: no ARCH) ----
ArchTest(rnifty)
ArchTest(rgold)
ArchTest(rcrude)

# ---- Step 3: Stationarity (H0: not stationary) ----
adf.test(rnifty)
adf.test(rgold)
adf.test(rcrude)

# ---- Step 4: Autocorrelation (H0: none) ----
Box.test(rnifty, lag = 10, type = "Ljung-Box")
Box.test(rgold,  lag = 10, type = "Ljung-Box")
Box.test(rcrude, lag = 10, type = "Ljung-Box")

# ---- Step 5: Normality (H0: normal) ----
jarque.bera.test(rnifty)
jarque.bera.test(rgold)
jarque.bera.test(rcrude)

# ---- GARCH(1,1): Nifty ----
spec_nifty <- ugarchspec(variance.model = list(model = "sGARCH", garchOrder = c(1, 1)),
                         mean.model = list(armaOrder = c(1, 1)), distribution.model = "std")
fit_nifty <- ugarchfit(spec = spec_nifty, data = rnifty)
fit_nifty

# ---- GARCH(1,1): Gold ----
spec_gold <- ugarchspec(variance.model = list(model = "sGARCH", garchOrder = c(1, 1)),
                        mean.model = list(armaOrder = c(0, 0)), distribution.model = "std")
fit_gold <- ugarchfit(spec = spec_gold, data = rgold)
fit_gold

# ---- GARCH(1,1): Crude oil ----
spec_crude <- ugarchspec(variance.model = list(model = "sGARCH", garchOrder = c(1, 1)),
                         mean.model = list(armaOrder = c(0, 0)), distribution.model = "std")
fit_crude <- ugarchfit(spec = spec_crude, data = rcrude)
fit_crude
plot(fit_crude, which = "all")

# Residual tests (Crude)
std_resid <- residuals(fit_crude, standardize = TRUE)
Box.test(std_resid, lag = 10, type = "Ljung-Box")
ArchTest(std_resid, lags = 10)

# Volatility forecast
fc_crude <- ugarchforecast(fit_crude, n.ahead = 10)
plot(fc_crude, which = 3)

# ---- EGARCH: Nifty ----
spec_egarch <- ugarchspec(variance.model = list(model = "eGARCH", garchOrder = c(1, 1)),
                          mean.model = list(armaOrder = c(0, 0)))
fit_egarch <- ugarchfit(spec = spec_egarch, data = rnifty)
fit_egarch
plot(fit_egarch, which = "all")

std_resid_e <- residuals(fit_egarch, standardize = TRUE)
acf(std_resid_e, main = "ACF of Standardized Residuals")
Box.test(std_resid_e, lag = 20, type = "Ljung-Box")
ArchTest(std_resid_e, lags = 12)

fc_egarch <- ugarchforecast(fit_egarch, n.ahead = 10)
plot(fc_egarch, which = 3)

# ---- GJR-GARCH (TGARCH) ----
spec_gjr <- ugarchspec(variance.model = list(model = "gjrGARCH", garchOrder = c(1, 1)),
                       mean.model = list(armaOrder = c(0, 0)))
fit_gjr <- ugarchfit(spec_gjr, data = rgold)
fit_gjr

# ---- DCC model ----
uspec <- ugarchspec(mean.model = list(armaOrder = c(0, 0)),
                    variance.model = list(garchOrder = c(1, 1), model = "sGARCH"),
                    distribution.model = "norm")
spec1 <- dccspec(uspec = multispec(replicate(3, uspec)), dccOrder = c(1, 1), distribution = "mvnorm")
modelfit <- dccfit(spec1, data = data.frame(YY))
modelfit

H <- rcov(modelfit)
R <- rcor(modelfit)

# Dynamic correlation for every pair
num_assets <- ncol(YY)
for (i in 1:(num_assets - 1)) {
  for (j in (i + 1):num_assets) {
    plot(R[i, j, ], type = "l",
         main = paste("DCC:", colnames(YY)[i], "vs", colnames(YY)[j]),
         xlab = "Time", ylab = "Correlation")
    grid()
  }
}

# ---- BEKK model ----
Y_mat <- as.matrix(YY)
bekk_spec_obj <- bekk_spec(model = list(type = "bekk", asymmetric = FALSE))
bekk_est <- bekk_fit(bekk_spec_obj, Y_mat, QML_t_ratios = TRUE)
summary(bekk_est)

# Shock spillover (A matrix)
A_pvalue <- 2 * (1 - pnorm(abs(bekk_est$A_t)))
print(bekk_est$A)
print(bekk_est$A_t)
print(A_pvalue)

# Volatility spillover (G matrix)
G_pvalue <- 2 * (1 - pnorm(abs(bekk_est$G_t)))
print(bekk_est$G)
print(bekk_est$G_t)
print(G_pvalue)
