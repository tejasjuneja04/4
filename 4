######################################################################
# Dataset 3: Nifty 50 (Nifty 50.xlsx)
######################################################################
# ---- Import and clean ----
path <- "Nifty 50.xlsx"          # change to your file location
df <- read_excel(path)
df <- df[, 1:2]
names(df) <- c("Date", "Price")
df$Date  <- as.Date(df$Date)
df$Price <- as.numeric(gsub(",", "", df$Price))
df <- df %>% arrange(Date) %>% na.omit()

zoo_price <- zoo(df$Price, order.by = df$Date)
Y <- ts(coredata(zoo_price))

# ---- Plot ----
plot(df$Date, df$Price, type = "l", main = "Nifty 50", xlab = "Date", ylab = "Value")

# ---- Moving averages ----
df$MA5  <- as.numeric(stats::filter(df$Price, rep(1/5, 5), sides = 2))
df$MA30 <- as.numeric(stats::filter(df$Price, rep(1/30, 30), sides = 2))

plot(df$Date, df$Price, type = "l", main = "5-Day Moving Average", xlab = "Date", ylab = "Value")
lines(df$Date, df$MA5, col = "red", lwd = 2)

plot(df$Date, df$Price, type = "l", main = "30-Day Moving Average", xlab = "Date", ylab = "Value")
lines(df$Date, df$MA30, col = "blue", lwd = 2)

# ---- Least squares trend ----
tt <- 1:nrow(df)
fit_trend <- lm(Price ~ tt, data = df)
df$Trend_LS <- fitted(fit_trend)
plot(df$Date, df$Price, type = "l", main = "Least Squares Trend", xlab = "Date", ylab = "Value")
lines(df$Date, df$Trend_LS, col = "darkgreen", lwd = 2)

# ---- Semi-averages ----
n <- nrow(df)
h <- floor(n / 2)
m1 <- mean(df$Price[1:h])
m2 <- mean(df$Price[(h + 1):n])
df$SemiAvg <- c(rep(m1, h), rep(m2, n - h))
plot(df$Date, df$Price, type = "l", main = "Semi-Averages Trend", xlab = "Date", ylab = "Value")
lines(df$Date, df$SemiAvg, col = "purple", lwd = 2)

# ---- Trend decomposition (short, medium, long) ----
df$MA_medium <- as.numeric(stats::filter(df$Price, rep(1/30, 30), sides = 2))
df$MA_long   <- as.numeric(stats::filter(df$Price, rep(1/90, 90), sides = 2))
df$Long_term   <- df$MA_long
df$Medium_term <- df$MA_medium - df$MA_long
df$Short_term  <- df$Price - df$MA_medium

par(mfrow = c(3, 1))
plot(df$Date, df$Long_term,   type = "l", main = "Long-Term (90-day trend)",  xlab = "Date", ylab = "Long-Term")
plot(df$Date, df$Medium_term, type = "l", main = "Medium-Term (30 vs 90)",    xlab = "Date", ylab = "Medium-Term")
plot(df$Date, df$Short_term,  type = "l", main = "Short-Term (around 30-day)", xlab = "Date", ylab = "Short-Term")
par(mfrow = c(1, 1))

# ---- Stationarity tests (level) ----
adf.test(Y)
pp.test(Y)
kpss.test(Y)

# Log returns
retlog <- diff(log(df$Price))
plot(retlog, type = "l", main = "Log returns")

# First difference and tests
retnifty <- diff(Y)
adf.test(retnifty)
pp.test(retnifty)
kpss.test(retnifty)
plot(retnifty)

# ---- ACF and PACF ----
acf(retnifty,  main = "ACF of First Differenced Series")
pacf(retnifty, main = "PACF of First Differenced Series")

# ---- Manual ARIMA models ----
fit_110 <- Arima(Y, order = c(1, 1, 0))
fit_011 <- Arima(Y, order = c(0, 1, 1))
fit_111 <- Arima(Y, order = c(1, 1, 1))
fit_211 <- Arima(Y, order = c(2, 1, 1))

cat("AIC:", AIC(fit_110), AIC(fit_011), AIC(fit_111), AIC(fit_211), "\n")
cat("BIC:", BIC(fit_110), BIC(fit_011), BIC(fit_111), BIC(fit_211), "\n")

print(accuracy(fit_110))
print(accuracy(fit_011))
print(accuracy(fit_111))
print(accuracy(fit_211))

# ---- Residual diagnostics ----
checkresiduals(fit_110)

# ---- Forecast (500 steps) ----
fc_110 <- forecast(fit_110, h = 500)
plot(fc_110, main = "ARIMA Forecast", xlab = "Time", ylab = "Price")

future_dates <- seq.Date(from = max(df$Date) + 1, by = "day", length.out = length(fc_110$mean))
fc_df <- data.frame(Date = future_dates, Forecast = as.numeric(fc_110$mean))

ggplot() +
  geom_line(data = df,    aes(x = Date, y = Price),    color = "blue", linewidth = 1) +
  geom_line(data = fc_df, aes(x = Date, y = Forecast), color = "red",  linewidth = 1) +
  labs(title = "Actual Series with ARIMA Forecast", x = "Date", y = "Price") +
  theme_minimal()

write.csv(data.frame(Forecast = as.numeric(fc_110$mean)), "nifty50_arima_forecast.csv", row.names = FALSE)

# ---- Auto ARIMA (200 steps) ----
fit_full <- auto.arima(Y)
summary(fit_full)

fc_full <- forecast(fit_full, h = 200)
future_dates2 <- seq.Date(from = max(df$Date) + 1, by = "day", length.out = 200)
fc_df2 <- data.frame(Date = future_dates2, Forecast = as.numeric(fc_full$mean))

ggplot() +
  geom_line(data = df,     aes(x = Date, y = Price),    color = "black", linewidth = 1) +
  geom_line(data = fc_df2, aes(x = Date, y = Forecast), color = "red",   linewidth = 1) +
  labs(title = "Out-of-sample ARIMA Forecast", x = "Date", y = "Price") +
  theme_minimal()

# ---- In-sample forecast: 80% train, 20% test ----
n <- length(zoo_price)
train_size <- floor(0.8 * n)
train_zoo <- zoo_price[1:train_size]
test_zoo  <- zoo_price[(train_size + 1):n]

train_ts  <- ts(coredata(train_zoo))
fit_train <- auto.arima(train_ts)
summary(fit_train)

fc_20 <- forecast(fit_train, h = length(test_zoo))
result_20 <- data.frame(Date = index(test_zoo),
                        Actual = as.numeric(coredata(test_zoo)),
                        Forecast = as.numeric(fc_20$mean))
full_actual <- data.frame(Date = index(zoo_price), Price = as.numeric(coredata(zoo_price)))

ggplot() +
  geom_line(data = full_actual, aes(x = Date, y = Price),    color = "black", linewidth = 1) +
  geom_line(data = result_20,   aes(x = Date, y = Forecast), color = "red",   linewidth = 1) +
  labs(title = "Nifty 50: Actual Series with 20% ARIMA Forecast", x = "Date", y = "Price") +
  theme_minimal()

mae_20  <- mean(abs(result_20$Actual - result_20$Forecast))
rmse_20 <- sqrt(mean((result_20$Actual - result_20$Forecast)^2))
cat("MAE:", mae_20, "\n")
cat("RMSE:", rmse_20, "\n")

